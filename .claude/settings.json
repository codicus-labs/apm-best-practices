{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "command -v apm >/dev/null 2>&1 || exit 0; exec apm hook claude",
            "type": "command"
          }
        ],
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|Bash|Grep"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "command -v apm >/dev/null 2>&1 || exit 0; exec apm hook claude",
            "type": "command"
          }
        ],
        "matcher": "compact|clear"
      }
    ]
  }
}
